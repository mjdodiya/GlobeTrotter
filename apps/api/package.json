{
  "name": "@globetrotter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=development --watch --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "test:integration": "node --conditions=development --test --env-file=../../.env test/*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@globetrotter/auth": "workspace:*",
    "@globetrotter/db": "workspace:*",
    "@globetrotter/domain": "workspace:*",
    "@hono/node-server": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "pino-pretty": "13.1.3"
  }
}
